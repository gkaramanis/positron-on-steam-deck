[
  { "key": "ctrl+shift+alt+a", "command": "editor.action.insertSnippet", "when": "editorTextFocus && !editorReadonly", "args": { "snippet": " <- " } },
  { "key": "ctrl+shift+alt+b", "command": "editor.action.insertSnippet", "when": "editorTextFocus && !editorReadonly", "args": { "snippet": " == " } },
  { "key": "ctrl+shift+alt+c", "command": "editor.action.insertSnippet", "when": "editorTextFocus && !editorReadonly", "args": { "snippet": " %in% " } },
  { "key": "ctrl+shift+alt+d", "command": "editor.action.insertSnippet", "when": "editorTextFocus && !editorReadonly", "args": { "snippet": " |> " } },
  { "key": "ctrl+shift+alt+e", "command": "editor.action.insertSnippet", "when": "editorTextFocus && !editorReadonly", "args": { "snippet": "~" } },
  { "key": "ctrl+shift+alt+f", "command": "editor.action.insertSnippet", "when": "editorTextFocus && !editorReadonly", "args": { "snippet": "library($1)" } },
  { "key": "ctrl+shift+alt+g", "command": "editor.action.insertSnippet", "when": "editorTextFocus && !editorReadonly", "args": { "snippet": "\"$1\"" } },
  { "key": "ctrl+shift+alt+h", "command": "editor.action.insertSnippet", "when": "editorTextFocus && !editorReadonly", "args": { "snippet": "mutate($1 = $2)" } },
  { "key": "ctrl+shift+alt+i", "command": "editor.action.insertSnippet", "when": "editorTextFocus && !editorReadonly", "args": { "snippet": "summarise($1, .by = $2)" } },
  { "key": "ctrl+shift+alt+j", "command": "editor.action.insertSnippet", "when": "editorTextFocus && !editorReadonly", "args": { "snippet": "c($1)" } },
  { "key": "ctrl+shift+alt+k", "command": "editor.action.insertSnippet", "when": "editorTextFocus && !editorReadonly", "args": { "snippet": "ggplot($1, aes($2)) +\n  geom_$3()" } },
  { "key": "ctrl+shift+alt+l", "command": "editor.action.insertSnippet", "when": "editorTextFocus && !editorReadonly", "args": { "snippet": "function($1) {\n  $2\n}" } }
